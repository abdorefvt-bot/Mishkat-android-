<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@android:color/transparent"
    android:padding="2dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_liquid_glass_bg"
        android:elevation="5dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="13dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/verse_text"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="28sp"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:breakStrategy="high_quality"
                android:fontFamily="@font/amiri_quran"
                android:gravity="center"
                android:includeFontPadding="true"
                android:lineSpacingExtra="2dp"
                android:lineSpacingMultiplier="1.08"
                android:maxLines="2"
                android:textAlignment="center"
                android:textColor="#542B35"
                android:textDirection="rtl"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/verse_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/ibm_plex_sans_arabic"
                android:gravity="center"
                android:includeFontPadding="true"
                android:maxLines="1"
                android:textColor="#8B7374"
                android:textDirection="rtl"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/widget_brand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0.22"
        android:maxLines="1"
        android:text="@string/widget_label_mishkat"
        android:textColor="#896F72"
        android:textSize="9sp" />
</LinearLayout>